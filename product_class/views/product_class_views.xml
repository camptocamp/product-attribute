<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_class_search" model="ir.ui.view">
        <field name="model">product.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Product Class" />
            </search>
        </field>
    </record>

    <record id="product_class_list" model="ir.ui.view">
        <field name="model">product.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="attribute_line_ids" />
            </list>
        </field>
    </record>

    <record id="product_class_form" model="ir.ui.view">
        <field name="model">product.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <separator string="Attributes" />
                    <field name="attribute_line_ids">
                        <list editable="bottom">
                            <field name="attribute_id" options="{'no_create': True}" />
                            <field name="required" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_class_action" model="ir.actions.act_window">
        <field name="name">Product Classes</field>
        <field name="res_model">product.class</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu entry under Inventory > Products > Configuration -->
    <menuitem
        id="menu_product_class_stock_config"
        name="Product Classes"
        parent="stock.menu_product_in_config_stock"
        action="product_class.product_class_action"
        sequence="25"
    />
    <!-- Menu entry under Sales > Products > Configuration -->
    <menuitem
        id="menu_product_class_sale_config"
        name="Product Classes"
        parent="sale.prod_config_main"
        action="product_class.product_class_action"
        sequence="25"
    />
</odoo>
