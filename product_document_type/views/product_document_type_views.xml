<odoo>
    <record id="product_document_type_view_form" model="ir.ui.view">
        <field name="model">product.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_document_type_view_list" model="ir.ui.view">
        <field name="model">product.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="sequence" />
            </list>
        </field>
    </record>

    <record id="product_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">product.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="product_document_type_menu"
        name="Document Types"
        action="product_document_type_action"
        parent="sale.prod_config_main"
        sequence="32"
    />
</odoo>
